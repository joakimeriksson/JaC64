diff --git a/vice/src/viciisc/vicii-mem.c b/vice/src/viciisc/vicii-mem.c
index e513732..c7fa1d7 100644
--- a/vice/src/viciisc/vicii-mem.c
+++ b/vice/src/viciisc/vicii-mem.c
@@ -43,6 +43,7 @@
 #include "vicii-mem.h"
 #include "vicii.h"
 #include "viciitypes.h"
+#include "maincpu.h"
 
 
 /* Unused bits in VIC-II registers: these are always 1 when read.  */
@@ -226,10 +227,33 @@ inline static void d018_store(const uint8_t value)
 
 inline static void d019_store(const uint8_t value)
 {
+    uint8_t before = vicii.irq_status;
     vicii.irq_status &= ~((value & 0xf) | 0x80);
     vicii_irq_set_line();
 
     VICII_DEBUG_REGISTER(("IRQ flag register: $%02X", vicii.irq_status));
+
+    /* JaC64 trace patch */
+    {
+        static FILE *jac64_trace = NULL;
+        static int trace_init = 0;
+        if (!trace_init) {
+            trace_init = 1;
+            const char *path = getenv("JAC64_TRACE_FILE");
+            if (path) jac64_trace = fopen(path, "a");
+        }
+        if (jac64_trace) {
+            fprintf(jac64_trace,
+                "EV-WrD019 clk=%llu rast=$%x cyc=%u ackVal=$%x oldFlags=$%x newFlags=$%x\n",
+                (unsigned long long)maincpu_clk,
+                vicii.raster_line,
+                vicii.raster_cycle,
+                value & 0xff,
+                before & 0xff,
+                vicii.irq_status & 0xff);
+            fflush(jac64_trace);
+        }
+    }
 }
 
 inline static void d01a_store(const uint8_t value)
@@ -274,10 +298,15 @@ inline static void color_reg_store(uint16_t addr, uint8_t value)
     vicii.last_color_value = value;
 }
 
+extern void jac64_dump_screen_ram_on_signal(uint8_t value);
+
 inline static void d020_store(uint8_t value)
 {
     VICII_DEBUG_REGISTER(("Border color register: $%02X", value));
 
+    /* JaC64 trace patch: dump screen RAM on test pass/fail signal. */
+    jac64_dump_screen_ram_on_signal(value);
+
     value &= 0x0f;
 
     color_reg_store(0x20, value);
@@ -501,20 +530,65 @@ inline static unsigned int read_raster_y(void)
 inline static uint8_t d01112_read(uint16_t addr)
 {
     unsigned int tmp = read_raster_y();
+    uint8_t result;
 
     VICII_DEBUG_REGISTER(("Raster Line register %svalue = $%04X",
                           (addr == 0x11 ? "(highest bit) " : ""), tmp));
     if (addr == 0x11) {
-        return (vicii.regs[addr] & 0x7f) | ((tmp & 0x100) >> 1);
+        result = (vicii.regs[addr] & 0x7f) | ((tmp & 0x100) >> 1);
     } else {
-        return tmp & 0xff;
+        result = tmp & 0xff;
+    }
+    /* JaC64 trace patch — only D012 */
+    if (addr == 0x12) {
+        static FILE *jac64_trace_d012 = NULL;
+        static int trace_init_d012 = 0;
+        if (!trace_init_d012) {
+            trace_init_d012 = 1;
+            const char *path = getenv("JAC64_TRACE_FILE");
+            if (path) jac64_trace_d012 = fopen(path, "a");
+        }
+        if (jac64_trace_d012) {
+            extern unsigned int reg_pc;
+            fprintf(jac64_trace_d012,
+                "EV-RdD012 clk=%llu val=%u line=%u cyc=%u pc=$%x\n",
+                (unsigned long long)maincpu_clk,
+                tmp & 0xff,
+                vicii.raster_line,
+                vicii.raster_cycle,
+                reg_pc & 0xffff);
+            fflush(jac64_trace_d012);
+        }
     }
+    return result;
 }
 
 
 inline static uint8_t d019_read(void)
 {
-    return vicii.irq_status | 0x70;
+    uint8_t v = vicii.irq_status | 0x70;
+    /* JaC64 trace patch */
+    {
+        static FILE *jac64_trace = NULL;
+        static int trace_init = 0;
+        if (!trace_init) {
+            trace_init = 1;
+            const char *path = getenv("JAC64_TRACE_FILE");
+            if (path) jac64_trace = fopen(path, "a");
+        }
+        if (jac64_trace) {
+            extern unsigned int reg_pc;
+            fprintf(jac64_trace,
+                "EV-RdD019 clk=%llu rast=$%x cyc=%u ret=$%x pc=$%x\n",
+                (unsigned long long)maincpu_clk,
+                vicii.raster_line,
+                vicii.raster_cycle,
+                v & 0xff,
+                reg_pc & 0xffff);
+            fflush(jac64_trace);
+        }
+    }
+    return v;
 }
 
 inline static uint8_t d01e_read(void)
@@ -531,6 +605,26 @@ inline static uint8_t d01e_read(void)
     VICII_DEBUG_REGISTER(("Sprite-sprite collision mask: $%02X",
                           vicii.regs[0x1e]));
 
+    /* JaC64 trace patch */
+    {
+        static FILE *jac64_trace = NULL;
+        static int trace_init = 0;
+        if (!trace_init) {
+            trace_init = 1;
+            const char *path = getenv("JAC64_TRACE_FILE");
+            if (path) jac64_trace = fopen(path, "a");
+        }
+        if (jac64_trace) {
+            fprintf(jac64_trace,
+                "EV-RdD01E clk=%llu rast=$%x cyc=%u ret=$%x\n",
+                (unsigned long long)maincpu_clk,
+                vicii.raster_line,
+                vicii.raster_cycle,
+                vicii.regs[0x1e] & 0xff);
+            fflush(jac64_trace);
+        }
+    }
+
     return vicii.regs[0x1e];
 }
 
