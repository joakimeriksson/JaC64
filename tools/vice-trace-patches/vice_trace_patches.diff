+/* JaC64 trace patch: dump screen RAM ($0400-$07ff) to JAC64_SCREEN_FILE
+   on the FIRST $d020 write that contains $02 (fail) or $05 (pass). The
+   irq-ack-vicii test (and most VICE-testprogs interrupts/* tests) end
+   with `sty $d020` carrying the final pass/fail signal, then `jmp *`.
+   Hooked here in c64memsc.c so it works regardless of the VIC-II
+   implementation. The hook is called from d020_store() in
+   viciisc/vicii-mem.c. */
+void jac64_dump_screen_ram_on_signal(uint8_t value)
+{
+    static int screen_dumped = 0;
+    int signal = value & 0x0f;
+    if (screen_dumped) return;
+    if (signal != 0x02 && signal != 0x05) return;
+    const char *path = getenv("JAC64_SCREEN_FILE");
+    if (!path) return;
+    FILE *fp = fopen(path, "w");
+    if (!fp) return;
+    int row, col;
+    for (row = 0; row < 25; row++) {
+        fprintf(fp, "row %02d: ", row);
+        for (col = 0; col < 40; col++) {
+            fprintf(fp, "%02x ", mem_ram[0x0400 + row * 40 + col] & 0xff);
+        }
+        fprintf(fp, "| ");
+        for (col = 0; col < 40; col++) {
+            int b = mem_ram[0x0400 + row * 40 + col] & 0xff;
+            int low = b & 0x7f;
+            char c;
+            if (low == 0x20) c = ' ';
+            else if (low >= 0x01 && low <= 0x1a)
+                c = (char)('A' + low - 1);
+            else if (low >= 0x30 && low <= 0x39)
+                c = (char)('0' + low - 0x30);
+            else if (low == 0x2e) c = '.';
+            else if (low == 0x2a) c = '*';
+            else if (low == 0x2d) c = '-';
+            else c = '.';
+            if (b & 0x80) c = (char)tolower((unsigned char)c);
+            fputc(c, fp);
+        }
+        fputc('\n', fp);
+    }
+    fprintf(fp, "; final $d020 value = $%02x (signal: %s)\n",
+            value & 0xff, signal == 0x05 ? "PASS" : "FAIL");
+    fclose(fp);
+    screen_dumped = 1;
+}
