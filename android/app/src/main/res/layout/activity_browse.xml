<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#202020">

    <!-- Top bar: back + title + source tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#4040E0"
        android:gravity="center_vertical"
        android:padding="6dp">

        <Button
            android:id="@+id/browse_btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:background="#6C6CFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Browse Content"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <Button
            android:id="@+id/browse_tab_latest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Latest"
            android:textColor="#FFFFFF"
            android:background="#6C6CFF" />

        <Button
            android:id="@+id/browse_tab_games"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Games"
            android:textColor="#FFFFFF"
            android:background="#6C6CFF"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Search row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp">

        <EditText
            android:id="@+id/browse_search_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Search CSDb by name..."
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <Button
            android:id="@+id/browse_btn_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search"
            android:textColor="#FFFFFF"
            android:background="#6C6CFF"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/browse_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#CCCCCC"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp" />

    <ListView
        android:id="@+id/browse_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#181818"
        android:cacheColorHint="#181818"
        android:divider="#333333"
        android:dividerHeight="1dp" />
</LinearLayout>
